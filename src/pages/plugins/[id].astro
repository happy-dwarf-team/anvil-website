---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DownloadButton from '../../components/DownloadButton.astro';
import PluginIcon from '../../components/PluginIcon.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import {
	describeGameBuild,
	formatDate,
	getLatestRelease,
	getReleasedManifest,
	pluginAsset,
	repoSlug,
} from '../../lib/release';
import { softwareApplication } from '../../lib/structured-data';
import { url } from '../../lib/url';

export async function getStaticPaths() {
	const plugins = await getCollection('plugins');
	return plugins.map((plugin) => ({ params: { id: plugin.id }, props: { plugin } }));
}

interface Props {
	plugin: CollectionEntry<'plugins'>;
}
const { plugin } = Astro.props;
const { name, summary, repo, status, manifestPath } = plugin.data;
const asset = pluginAsset(plugin.id, plugin.data.asset);
const slug = repoSlug(repo);

// The released plugin.toml is the source of truth; the frontmatter is the fallback when
// GitHub cannot be reached at build time.
const release = await getLatestRelease(slug, asset);
const manifest = release ? await getReleasedManifest(release, manifestPath) : null;
const gameBuilds = manifest?.gameBuilds.length ? manifest.gameBuilds : plugin.data.gameBuilds;
const affectsGameplay = manifest?.affectsGameplay ?? plugin.data.affectsGameplay;
if (manifest && manifest.affectsGameplay !== plugin.data.affectsGameplay) {
	console.warn(`[catalog] ${plugin.id}: affectsGameplay differs between the frontmatter and plugin.toml.`);
}

const jsonLd = softwareApplication({
	name,
	description: summary,
	pageUrl: new URL(Astro.url.pathname, Astro.site).href,
	repoUrl: repo,
	release,
});

const { Content, headings } = await render(plugin);
const pageHeadings = [...headings, { depth: 2, slug: 'supported-game-builds', text: 'Supported game builds' }];
---

<StarlightPage frontmatter={{ title: name, description: summary, head: [jsonLd] }} headings={pageHeadings} hasSidebar={false}>
	<a class="back" href={url('plugins/')}><span aria-hidden="true">←</span> All plugins</a>
	<div class="facts">
		<PluginIcon id={plugin.id} size={40} />
		<dl>
			<div>
				<dt>Status</dt>
				<dd><StatusBadge status={status} /></dd>
			</div>
			{
				release && (
					<div>
						<dt>Latest version</dt>
						<dd>
							<a href={release.pageUrl}>{release.version}</a>
							<span class="muted">{formatDate(release.publishedAt)}</span>
						</dd>
					</div>
				)
			}
			{
				manifest?.anvil && (
					<div>
						<dt>Requires</dt>
						<dd>
							<a href={url('docs/install/')}>Anvil</a>
							<code>{manifest.anvil}</code>
						</dd>
					</div>
				)
			}
			<div>
				<dt>Game builds</dt>
				<dd>{gameBuilds.map((b) => <code>{b}</code>)}</dd>
			</div>
			<div>
				<dt>Changes gameplay</dt>
				<dd>{affectsGameplay ? 'Yes: may affect multiplayer and ironman' : 'No'}</dd>
			</div>
			<div>
				<dt>Source</dt>
				<dd><a href={repo}>{slug}</a></dd>
			</div>
		</dl>
	</div>
	<div class="get">
		<DownloadButton name={name} repo={slug} asset={asset} align="start" />
	</div>
	<Content />
	<h2 id="supported-game-builds">Supported game builds</h2>
	<ul>
		{
			gameBuilds.map((build) =>
				build === '*' ? (
					<li>Any game build: the plugin does not use game addresses.</li>
				) : (
					<li>
						{describeGameBuild(build)}, <code>{build}</code>
					</li>
				),
			)
		}
	</ul>
	<p>On any other build Anvil skips the plugin and the game starts normally.</p>
</StarlightPage>

<style>
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		color: var(--forge-text-muted);
		text-decoration: none;
	}
	.back:hover {
		color: var(--forge-text);
	}
	.facts {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin: 1rem 0 2rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--forge-border);
		border-radius: var(--forge-radius);
		background: var(--forge-surface);
	}
	.facts dl {
		flex: 1;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem 2rem;
	}
	.facts > *,
	.facts dl div {
		margin: 0;
	}
	dt {
		color: var(--forge-text-muted);
		font-size: var(--sl-text-xs);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	dd {
		margin: 0.25rem 0 0;
		/* Starlight indents <dd> in content; values sit under their labels here. */
		padding-inline-start: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem;
	}
	.muted {
		color: var(--forge-text-muted);
		font-size: var(--sl-text-sm);
	}
	.get {
		margin-bottom: 2rem;
	}
</style>
