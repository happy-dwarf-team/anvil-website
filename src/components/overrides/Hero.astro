---
// Only the home page sets `hero`, so this replaces Starlight's hero with the landing header.
import DownloadButton from '../DownloadButton.astro';
import mark from '../../assets/anvil-mark.svg';
import { ANVIL_ASSET, ANVIL_MANAGER_ASSET, getLatestRelease } from '../../lib/release';
import { url } from '../../lib/url';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
// The main button is Anvil Manager, which installs Anvil; the zip stays as the manual install.
// A release without the Manager (before 1.2) falls back to the zip.
const manager = await getLatestRelease(undefined, ANVIL_MANAGER_ASSET);
const zip = await getLatestRelease(undefined, ANVIL_ASSET);
---

<header class="hero">
	<img class="mark" src={mark.src} alt="" width="72" height="72" />
	<h1 id="_top" class="forge-heading" data-page-title set:html={title} />
	{tagline && <p class="tagline" set:html={tagline} />}
	{
		manager ? (
			<DownloadButton asset={ANVIL_MANAGER_ASSET} fileLabel="Anvil Manager, the installer" />
		) : (
			<DownloadButton />
		)
	}
	{
		manager && zip && (
			<p class="manual">
				Or the <a href={zip.downloadUrl}>{ANVIL_ASSET}</a> for a{' '}
				<a href={url('docs/install/#install-by-hand')}>manual install</a>.
			</p>
		)
	}
	<a class="github" href="https://github.com/happy-dwarf-team/anvil">
		Source on GitHub <span aria-hidden="true">→</span>
	</a>
</header>

<style>
	.manual {
		margin: -0.5rem 0 0;
		color: var(--forge-text-muted);
		font-size: var(--sl-text-sm);
	}
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		padding-block: clamp(2.5rem, 8vw, 5.5rem) 1rem;
		text-align: center;
	}
	.mark {
		width: 4.5rem;
		height: 4.5rem;
	}
	h1 {
		margin: 0;
		color: var(--sl-color-white);
		font-size: clamp(2.5rem, 7vw, 4rem);
		font-weight: 800;
		line-height: 1.05;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.tagline {
		max-width: 34rem;
		margin: 0 0 0.75rem;
		color: var(--forge-text-muted);
		font-size: clamp(1.125rem, 2.5vw, 1.3rem);
		text-wrap: balance;
	}
	.tagline :global(code) {
		color: var(--forge-text);
	}
	.github {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		color: var(--forge-text);
		font-weight: 500;
		text-decoration: none;
	}
	.github:hover {
		color: var(--forge-accent-strong);
	}
</style>
