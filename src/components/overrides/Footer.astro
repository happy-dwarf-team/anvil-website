---
// Starlight's footer, then the team link, the licence, the team's Discord server and the family
// disclaimer, on every page (404 included). The Discord link goes through the hub's
// discord.happydwarf.dev redirect, so a new invite changes no page.
import { Image } from 'astro:assets';
import Default from '@astrojs/starlight/components/Footer.astro';
import dwarf from '../../assets/happy-dwarf.svg';
---

<Default />

<div class="site-footer">
	<a class="team" href="https://github.com/happy-dwarf-team">
		<Image src={dwarf} alt="" width={80} height={80} />
		<span>Happy Dwarf Team</span>
	</a>
	<p>Anvil and its plugins are MIT-licensed.</p>
	<p>Questions? Ask on the team's <a href="https://discord.happydwarf.dev/">Discord server</a>.</p>
	<p class="disclaimer">
		Anvil and its plugins are an unofficial community project, not affiliated with or endorsed
		by Paradox Interactive. Europa Universalis and Paradox Interactive are trademarks or
		registered trademarks of Paradox Interactive AB. Game interface art in screenshots is ©
		Paradox Interactive AB, rendered from a local copy of the game; Anvil does not include or
		distribute game files.
	</p>
</div>

<style>
	.site-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--forge-border);
		color: var(--forge-text-muted);
		font-size: var(--sl-text-sm);
	}
	.site-footer p {
		margin: 0;
		max-width: 36rem;
	}
	.site-footer p a {
		color: var(--forge-text);
	}
	.site-footer p a:hover {
		color: var(--forge-accent-strong);
	}
	.site-footer .disclaimer {
		flex-basis: 100%;
		max-width: 52rem;
		font-size: 0.8125rem;
	}
	.team {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 2.75rem;
		color: var(--forge-text);
		font-weight: 600;
		text-decoration: none;
	}
	.team:hover span {
		color: var(--forge-accent-strong);
	}
	.team img {
		width: 2.5rem;
		height: 2.5rem;
	}
</style>
