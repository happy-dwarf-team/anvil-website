---
// A plugin's icon is src/assets/plugins/<plugin id>.svg. A plugin without one renders nothing.
// The icon is inlined and decorative: its accent is currentColor, set to --forge-accent here.
import type { SvgComponent } from 'astro/types';

interface Props {
	id: string;
	size?: number;
	class?: string;
}
const { id, size = 32, class: className } = Astro.props;

const icons = import.meta.glob<SvgComponent>('../assets/plugins/*.svg', {
	eager: true,
	import: 'default',
});
const Icon = icons[`../assets/plugins/${id}.svg`];
---

{Icon && <Icon class:list={['plugin-icon', className]} width={size} height={size} aria-hidden="true" />}

<style>
	.plugin-icon {
		flex: none;
		color: var(--forge-accent);
	}
</style>
