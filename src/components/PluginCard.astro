---
import type { CollectionEntry } from 'astro:content';
import { formatDate, getLatestRelease, pluginAsset, repoSlug, workshopUrl } from '../lib/release';
import { url } from '../lib/url';
import PluginIcon from './PluginIcon.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
	plugin: CollectionEntry<'plugins'>;
}
const { plugin } = Astro.props;
const { name, summary, status, highlight, repo, asset, workshop } = plugin.data;
const release = await getLatestRelease(repoSlug(repo), pluginAsset(plugin.id, asset));
---

<article class="plugin-card">
	<div class="head">
		<h3 class="forge-heading">
			<PluginIcon id={plugin.id} size={28} />
			<a href={url(`plugins/${plugin.id}/`)}>{name}</a>
		</h3>
		<div class="status">
			<StatusBadge status={status} version={release?.version} />
			{
				release && (
					<span class="updated">
						Updated <time datetime={release.publishedAt.toISOString().slice(0, 10)}>{formatDate(release.publishedAt)}</time>
					</span>
				)
			}
		</div>
	</div>
	<p>{summary}</p>
	{
		workshop && (
			<a class="workshop" href={workshopUrl(workshop)}>
				Also on the Steam Workshop<span class="sr-only">: {name}</span>
			</a>
		)
	}
	{
		highlight && (
			<p class="highlight">
				<span class="label">{highlight.label}</span>
				<span class="numbers">
					{highlight.before} <span aria-hidden="true">→</span><span class="sr-only"> to </span>{' '}
					<strong>{highlight.after}</strong>
				</span>
			</p>
		)
	}
</article>

<style>
	.plugin-card {
		position: relative;
		/* Overrides Starlight's sibling margin-top in content; the page's scoped grid reset
		   does not reach this component's root, and grids space cards with gap. */
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--forge-border);
		border-radius: var(--forge-radius);
		background: var(--forge-surface);
		transition:
			border-color 180ms var(--forge-ease),
			transform 180ms var(--forge-ease);
	}
	.plugin-card:hover,
	.plugin-card:focus-within {
		border-color: var(--forge-accent);
		transform: translateY(-2px);
	}
	.head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.status {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.3rem;
		flex-shrink: 0;
	}
	.updated {
		color: var(--forge-text-muted);
		font-size: var(--sl-text-xs);
		white-space: nowrap;
	}
	h3 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-size: var(--sl-text-xl);
	}
	h3 a {
		color: var(--sl-color-white);
		text-decoration: none;
	}
	/* The whole card is clickable through the heading link. */
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}
	p {
		margin: 0;
		color: var(--forge-text-muted);
	}
	/* Above the heading link's overlay, so it stays a link of its own. */
	.workshop {
		position: relative;
		z-index: 1;
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		margin: -0.5rem 0;
		color: var(--forge-text);
		font-size: var(--sl-text-sm);
	}
	.workshop:hover {
		color: var(--forge-accent-strong);
	}
	.highlight {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: auto;
		padding-top: 0.75rem;
		border-top: 1px solid var(--forge-border);
		font-size: var(--sl-text-sm);
	}
	.numbers {
		font-family: var(--__sl-font-mono);
		color: var(--forge-text);
	}
	.numbers strong {
		color: var(--forge-accent);
	}
</style>
