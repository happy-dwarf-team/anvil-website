---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import PluginIcon from './PluginIcon.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
	plugin: CollectionEntry<'plugins'>;
}
const { plugin } = Astro.props;
const { name, summary, status, highlight } = plugin.data;
---

<article class="plugin-card">
	<div class="head">
		<h3 class="forge-heading">
			<PluginIcon id={plugin.id} size={28} />
			<a href={url(`plugins/${plugin.id}/`)}>{name}</a>
		</h3>
		<StatusBadge status={status} />
	</div>
	<p>{summary}</p>
	{
		highlight && (
			<p class="highlight">
				<span class="label">{highlight.label}</span>
				<span class="numbers">
					{highlight.before} <span aria-label="to">→</span> <strong>{highlight.after}</strong>
				</span>
			</p>
		)
	}
</article>

<style>
	.plugin-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--forge-border);
		border-radius: var(--forge-radius);
		background: var(--forge-surface);
		transition:
			border-color 180ms var(--forge-ease),
			transform 180ms var(--forge-ease);
	}
	.plugin-card:hover,
	.plugin-card:focus-within {
		border-color: var(--forge-accent);
		transform: translateY(-2px);
	}
	.head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	h3 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-size: var(--sl-text-xl);
	}
	h3 a {
		color: var(--sl-color-white);
		text-decoration: none;
	}
	/* The whole card is clickable through the heading link. */
	h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}
	p {
		margin: 0;
		color: var(--forge-text-muted);
	}
	.highlight {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: auto;
		padding-top: 0.75rem;
		border-top: 1px solid var(--forge-border);
		font-size: var(--sl-text-sm);
	}
	.numbers {
		font-family: var(--__sl-font-mono);
		color: var(--forge-text);
	}
	.numbers strong {
		color: var(--forge-accent);
	}
</style>
