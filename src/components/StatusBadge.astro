---
interface Props {
	status: 'planned' | 'in-development' | 'released';
	// Latest released version. When known, the badge shows only the version: a plugin with a
	// release is released, and 0.x already says how early it is.
	version?: string;
}
const labels = {
	planned: 'Planned',
	'in-development': 'In development',
	released: 'Released',
} as const;
const { status, version } = Astro.props;
---

{
	version ? (
		<span class="badge released version">
			<span class="sr-only">Latest version </span>v{version}
		</span>
	) : (
		<span class:list={['badge', status]}>{labels[status]}</span>
	)
}

<style>
	.badge {
		flex-shrink: 0;
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--forge-border);
		border-radius: 999px;
		color: var(--forge-text-muted);
		font-size: var(--sl-text-xs);
		font-weight: 500;
		white-space: nowrap;
	}
	.version {
		font-family: var(--__sl-font-mono);
	}
	.released {
		border-color: var(--forge-accent);
		color: var(--forge-accent-strong);
	}
</style>
