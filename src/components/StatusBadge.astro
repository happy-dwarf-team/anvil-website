---
interface Props {
	status: 'planned' | 'in-development' | 'released';
	// Latest released version, shown after the label when known.
	version?: string;
}
const labels = {
	planned: 'Planned',
	'in-development': 'In development',
	released: 'Released',
} as const;
const { status, version } = Astro.props;
---

<span class:list={['badge', status]}>
	{labels[status]}
	{version && <span class="version">{version}</span>}
</span>

<style>
	.badge {
		flex-shrink: 0;
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--forge-border);
		border-radius: 999px;
		color: var(--forge-text-muted);
		font-size: var(--sl-text-xs);
		font-weight: 500;
		white-space: nowrap;
	}
	.version {
		margin-inline-start: 0.4rem;
		font-family: var(--__sl-font-mono);
	}
	.released {
		border-color: var(--forge-accent);
		color: var(--forge-accent-strong);
	}
</style>
